# Normalize line endings in the repository to LF...
* text=auto eol=lf

# ...but always check web assets out with LF, so the served files match
# what was committed and diffs never show whole-file line-ending churn.
*.html  text eol=lf diff=html
*.css   text eol=lf diff=css
*.js    text eol=lf diff=js
*.json  text eol=lf
*.md    text eol=lf diff=markdown
*.mjs   text eol=lf

# Binary assets — never touched by line-ending conversion.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.woff  binary
*.woff2 binary